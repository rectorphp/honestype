# Copy into a target PHP repo as .github/workflows/docblock-check.yml
name: docblock-check

on:
  pull_request:

env:
  DOCBLOCK_CHECK_LOG: /tmp/docblock-check.log

jobs:
  docblock-check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: shivammathur/setup-php@v2
        with:
          php-version: '8.3'

      - uses: actions/setup-go@v5
        with:
          go-version: '1.26'

      - name: Install honestype
        run: |
          go install github.com/rectorphp/honestype@main
          echo "$(go env GOPATH)/bin" >> "$GITHUB_PATH"

      - name: Install PHP deps
        run: composer install --no-interaction --no-progress

      - name: Instrument sources
        run: honestype instrument src

      # Load the helper for every PHP process, including parallel test workers
      # that do not inherit a -d auto_prepend_file flag.
      - name: Enable runtime helper globally
        run: |
          INI="$(php -i | grep '^Loaded Configuration File' | awk '{print $NF}')"
          echo "auto_prepend_file=$GITHUB_WORKSPACE/src/docblock_check.php" | sudo tee -a "$INI"

      - name: Run tests (collect mismatches)
        run: vendor/bin/phpunit || true   # tests may fail; we only need the log

      - name: Restore sources
        if: always()
        run: git checkout -- src && rm -f src/docblock_check.php

      - name: List docblock type mismatches
        run: honestype report "$DOCBLOCK_CHECK_LOG"
