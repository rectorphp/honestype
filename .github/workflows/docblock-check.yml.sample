# Copy into a target PHP repo as .github/workflows/docblock-check.yml
name: docblock-check

on:
  pull_request:

jobs:
  docblock-check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: shivammathur/setup-php@v2
        with:
          php-version: '8.3'

      - uses: actions/setup-go@v5
        with:
          go-version: '1.26'

      - name: Install honestype
        run: |
          go install github.com/rectorphp/honestype@main
          echo "$(go env GOPATH)/bin" >> "$GITHUB_PATH"

      - name: Install PHP deps
        run: composer install --no-interaction --no-progress

      - name: Instrument sources
        run: honestype instrument src

      - name: Run tests (collect mismatches)
        env:
          DOCBLOCK_CHECK_LOG: ${{ github.workspace }}/docblock-check.log
        run: vendor/bin/phpunit || true   # tests may fail; we only need the log

      - name: Restore sources
        if: always()
        run: git checkout -- src && rm -f src/docblock_check.php

      - name: Report and annotate
        run: |
          honestype report -github "${{ github.workspace }}/docblock-check.log" || echo "no mismatches"
